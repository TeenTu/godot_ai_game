# DeepSeek API key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=

# 视觉模型，默认 deepseek-v4-flash-vision-exp
VISION_MODEL=deepseek-v4-flash-vision-exp

# low=512x512 更快更省（适合"画面里有没有 X"这类判断）
# high=原图（适合读分数等精细信息，慢且 token 更多）
VISION_DETAIL=low

# 1 时使用 mock 视觉（不调用 API），用于验证框架链路
VISION_MOCK=0

# 视觉断言失败后的重试次数
VISION_RETRY=2

# 被测地址，留空则使用 YAML 里的 base_url
# 例：BASE_URL=http://localhost:8123/  或线上 https://teentu.github.io/godot_ai_game/suika/
BASE_URL=

# 本地构建产物根目录（run.sh 用它起本地服务，路径相对 tools/vision-e2e/）
WEB_ROOT=../../build/web
