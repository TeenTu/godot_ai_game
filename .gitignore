# Godot 4+ specific ignores
.godot/
/android/

# WorkBuddy 会话产物（记忆 / 临时文件），跟项目无关
.workbuddy/

# Export build output (rebuild by CI on every push to main)
build/
dist/

# System/tooling
.DS_Store
Thumbs.db

# NOTE: export_presets.cfg is intentionally NOT ignored here.
# The CI pipeline (GitHub Actions) needs it to run headless exports.
# Do not re-add it to this file.

# NOTE: *.uid and *.import files are also intentionally NOT ignored.
# - *.uid (Godot 4.4+): stable resource IDs; without them every fresh
#   checkout/import generates new UIDs, which breaks uid:// references.
# - *.import: pinned import settings, so CI reproduces the exact same
#   import result as local builds (the .godot/ cache itself stays ignored).
# Do not re-add these to this file.

# game_kit / shared assets are injected from shared/ by tools/sync_shared.sh and CI — do not commit copies
games/*/addons/
games/*/assets/_shared/
