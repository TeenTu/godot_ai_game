; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="B-Boom"
config/description="B-Boom: 百怪夜巡，竖屏俯视新国风轻 Q 割草动作游戏。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

TestHook="*res://scripts/test_hook.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"

[game_kit]

asset_style="boom-night-2d"

[gui]

# Web 导出无系统 CJK 回退：全 UI 使用项目自带中文子集主题（msyh 子集，
# 覆盖 scripts/tools 全部用字）。custom_font 不参与默认主题字体切换，
# 必须用 custom Theme 资源（default_font）；运行时另见 main.gd 顶层
# Control.theme 赋值（编辑器侧只认这里的设置）。见 DESIGN_M10 §9。
theme/custom="res://assets/fonts/ui_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(1, 0.85, 0.64, 1)
