; Engine configuration file.
; It's best edited using the editing UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="太空闪避"
config/description="game_kit 共享套件示例游戏：虚拟摇杆操控 + 刘海安全区适配，Web 端由 GitHub Actions 自动导出部署。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/ui_subset.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=true

[game_kit]

asset_style="flat-cartoon"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
